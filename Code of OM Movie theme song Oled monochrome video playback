// Decode one 1024-byte frame from RFC1924 Base85.
static const char B85[] = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz!#$%&()*+-;<=>?@^_`{|}~";
static bool decodeFrame(uint32_t frameIndex, uint8_t *out) {
  const uint32_t start = frameIndex * ENCODED_FRAME_CHARS;
  uint32_t outPos = 0;
  for (uint32_t i = 0; i < ENCODED_FRAME_CHARS; i += 5) {
    uint32_t value = 0;
    for (uint8_t j = 0; j < 5; ++j) {
      char c = (char)pgm_read_byte(videoData + start + i + j);
      const char *found = strchr(B85, c);
      if (!found) return false;
      value = value * 85UL + (uint8_t)(found - B85);
    }
    out[outPos++] = (uint8_t)(value >> 24);
    out[outPos++] = (uint8_t)(value >> 16);
    out[outPos++] = (uint8_t)(value >> 8);
    out[outPos++] = (uint8_t)value;
  }
  return outPos == FRAME_BYTES;
}

void setup() {
  Wire.begin(21, 22); // ESP32 DevKit V1: SDA=GPIO21, SCL=GPIO22
  Wire.setClock(400000);
  if (!display.begin(SSD1306_SWITCHCAPVCC, OLED_ADDR)) {
    while (true) delay(1000);
  }
  display.clearDisplay();
  display.setTextColor(SSD1306_WHITE);
  display.setTextSize(1);
  display.setCursor(0, 0);
  display.println(F("OLED VIDEO PLAYER"));
  display.println(F("Loading video..."));
  display.display();
  delay(700);
}

void loop() {
  static uint8_t frame[FRAME_BYTES];
  const uint32_t frameDurationUs = 1000000UL / FPS;
  for (uint32_t index = 0; index < FRAME_COUNT; ++index) {
    const uint32_t frameStart = micros();
    if (!decodeFrame(index, frame)) {
      display.clearDisplay();
      display.setCursor(0, 0);
      display.println(F("DATA ERROR"));
      display.display();
      delay(2000);
      return;
    }
    display.clearDisplay();
    display.drawBitmap(0, 0, frame, SCREEN_WIDTH, SCREEN_HEIGHT, SSD1306_WHITE);
    display.display();
    const uint32_t elapsed = micros() - frameStart;
    if (elapsed < frameDurationUs) delayMicroseconds(frameDurationUs - elapsed);
  }
  // Restart video from the beginning after the final frame.
}
